# Solana RPC — Alchemy key only, the keeper builds the full URL
USDX_LOOP_VAULT_ALCHEMY_RPC_API_KEY=

# Keeper wallet (reads the Solana CLI keypair file)
KEEPER_KEYPAIR_PATH=~/.config/solana/id.json

# Supabase (keeper state / run history). Service role key is used server-side only.
STABLE_AGENTS_SUPABASE_PROJECT_ID=
STABLE_AGENTS_SUPABASE_PROJECT_URL=
STABLE_AGENTS_SUPABASE_SERVICE_ROLE=
STABLE_AGENTS_SUPABASE_ANON_PUBLIC=

# Optional: test wallet used by scripts/ for end-to-end integration runs
LOOP_TESTER_WALLET_ADDRESS=
LOOP_TESTER_PRIVATE_KEY=

# HTTP server port for the keeper's webhook + health endpoints
PORT=3000
